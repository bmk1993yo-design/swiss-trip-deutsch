  "grammar": {
    "id": "gern",
    "title": "gern: Ich esse gern Käse. / Ich mag …",
    "pattern": "동사 + gern / mag + 명사",
    "meaning": "“~하는 것을 좋아해요 / ~을 좋아해요”",
    "explanation": "독일어에서 어떤 행동을 즐겨 하거나 좋아한다고 표현할 때는 동사 뒤에 'gern'을 붙입니다. 예를 들어 'essen gern'은 '즐겨 먹다'라는 의미가 됩니다. 또한 명사 자체를 좋아하는 경우에는 'mögen' 동사(1인칭 Ich mag)를 써서 직접 선호를 나타낼 수도 있습니다.",
    "examples": [
      {
        "german": "Ich esse gern Schokolade.",
        "meaning": "저는 초콜릿을 즐겨 먹어요."
      },
      {
        "german": "Ich mag Raclette.",
        "meaning": "저는 라클렛을 좋아해요."
      }
    ],
    "tip": "식당이나 가게에서 선호를 밝히거나 시식을 청할 때 매우 유용하게 쓰입니다."
  }
