  "grammar": {
    "id": "koennen-faehigkeit",
    "title": "können(능력): Ich kann (nicht) Ski fahren.",
    "pattern": "주어 + können(변형) + … + 동사원형",
    "meaning": "“~할 수 있다 / ~할 줄 안다”",
    "explanation": "조동사 können은 능력이나 가능성을 나타낼 때 씁니다. 주어에 따라 형태가 변하며, 문장 맨 끝에는 기본형(동사원형)이 옵니다. 부정할 때는 'nicht'를 붙입니다.",
    "examples": [
      {
        "german": "Ich kann gut Ski fahren.",
        "meaning": "저는 스기를 잘 탈 수 있어요."
      },
      {
        "german": "Kannst du mir helfen?",
        "meaning": "저를 도와줄 수 있나요?"
      }
    ],
    "tip": "주어가 'ich'(나)일 때는 'kann', 'du'(너)일 때는 'kannst'가 됩니다."
  }
}
