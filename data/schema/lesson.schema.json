{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swiss-trip-deutsch/lesson.schema.json",
  "title": "Lesson",
  "description": "Swiss Trip Deutsch 하루치. data/lessons/YYYY-MM-DD.json 파일 하나가 lessonDay 또는 reviewDay 하나에 대응한다.",
  "oneOf": [
    {
      "$ref": "#/$defs/lessonDay"
    },
    {
      "$ref": "#/$defs/reviewDay"
    }
  ],
  "$defs": {
    "lessonDay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "schemaVersion",
        "date",
        "day",
        "unlockAt",
        "theme",
        "approved",
        "words",
        "sentences",
        "grammar"
      ],
      "properties": {
        "type": {
          "const": "lesson"
        },
        "schemaVersion": {
          "const": 1
        },
        "date": {
          "description": "레슨 날짜 (KST). 파일명과 같아야 한다.",
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "day": {
          "description": "코스 내 일차 (1부터 시작)",
          "type": "integer",
          "minimum": 1
        },
        "unlockAt": {
          "description": "공개 시각. 항상 해당 날짜 17:00 KST.",
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T17:00:00\\+09:00$"
        },
        "theme": {
          "$ref": "#/$defs/theme"
        },
        "approved": {
          "description": "검수 통과 여부. false인 레슨은 배포되어도 화면에 표시하지 않는다.",
          "type": "boolean"
        },
        "words": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/word"
          }
        },
        "sentences": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/sentence"
          }
        },
        "grammar": {
          "$ref": "#/$defs/grammar"
        }
      },
      "description": "새 레슨 (단어 10 · 문장 3 · 문법 1)"
    },
    "reviewDay": {
      "description": "주간 복습 날. 내용은 reviewOf 레슨들에서 앱이 퀴즈로 구성한다 (LLM 생성 없음).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "schemaVersion",
        "date",
        "day",
        "unlockAt",
        "theme",
        "approved",
        "reviewOf"
      ],
      "properties": {
        "type": {
          "const": "review"
        },
        "schemaVersion": {
          "const": 1
        },
        "date": {
          "description": "레슨 날짜 (KST). 파일명과 같아야 한다.",
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "day": {
          "description": "코스 내 일차 (1부터 시작)",
          "type": "integer",
          "minimum": 1
        },
        "unlockAt": {
          "description": "공개 시각. 항상 해당 날짜 17:00 KST.",
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T17:00:00\\+09:00$"
        },
        "theme": {
          "$ref": "#/$defs/theme"
        },
        "approved": {
          "description": "검수 통과 여부. false인 레슨은 배포되어도 화면에 표시하지 않는다.",
          "type": "boolean"
        },
        "reviewOf": {
          "description": "복습 대상 레슨 날짜",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "emoji"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "title": {
          "description": "한국어 테마명",
          "type": "string",
          "minLength": 1
        },
        "emoji": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pronunciationSyllable": {
      "description": "한국어 발음 도움 한 덩어리. stress=true인 덩어리를 화면에서 강조한다.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "stress"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "stress": {
          "type": "boolean"
        }
      }
    },
    "pronunciation": {
      "description": "IPA가 기준 데이터, korean은 보조 수단.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ipa",
        "korean"
      ],
      "properties": {
        "ipa": {
          "description": "슬래시로 감싼 IPA. 관사는 제외하고 단어(또는 문장 전체)만 표기.",
          "type": "string",
          "pattern": "^/.+/$"
        },
        "korean": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/pronunciationSyllable"
          }
        }
      }
    },
    "audio": {
      "description": "목소리별 음성. public/ 기준 경로이며 generate_lessons.py가 채우고 generate_audio.py가 이 경로에 파일을 만든다. 예: /audio/2026-10-06/word-01-aiden.opus",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aiden",
        "serena"
      ],
      "properties": {
        "aiden": {
          "$ref": "#/$defs/audioPair"
        },
        "serena": {
          "$ref": "#/$defs/audioPair"
        }
      }
    },
    "word": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "german",
        "meaning",
        "partOfSpeech",
        "pronunciation",
        "audio",
        "isSwissExpression"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^word-\\d{2}$"
        },
        "german": {
          "description": "표시용 표제어. 명사는 관사 포함 (예: die Bordkarte). 스위스식 표기(ß 대신 ss).",
          "type": "string",
          "not": {
            "pattern": "ß"
          }
        },
        "meaning": {
          "description": "한국어 뜻",
          "type": "string",
          "minLength": 1
        },
        "partOfSpeech": {
          "enum": [
            "noun",
            "verb",
            "adjective",
            "adverb",
            "preposition",
            "pronoun",
            "interjection",
            "phrase"
          ]
        },
        "gender": {
          "enum": [
            "der",
            "die",
            "das"
          ]
        },
        "plural": {
          "description": "복수형 (관사 포함). 복수가 없으면 null.",
          "type": [
            "string",
            "null"
          ]
        },
        "pronunciation": {
          "$ref": "#/$defs/pronunciation"
        },
        "audio": {
          "$ref": "#/$defs/audio"
        },
        "isSwissExpression": {
          "description": "스위스 고유 표현이면 true. 별도 검증 대상.",
          "type": "boolean"
        },
        "swissNote": {
          "description": "🇨🇭 Swiss Tip",
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "partOfSpeech": {
                "const": "noun"
              }
            }
          },
          "then": {
            "required": [
              "gender",
              "plural"
            ],
            "properties": {
              "german": {
                "pattern": "^(der|die|das) "
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "gender"
              ]
            }
          }
        }
      ]
    },
    "sentence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "german",
        "meaning",
        "pronunciation",
        "audio"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^sentence-\\d{2}$"
        },
        "german": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "ß"
          }
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "pronunciation": {
          "$ref": "#/$defs/pronunciation"
        },
        "audio": {
          "$ref": "#/$defs/audio"
        },
        "usesWords": {
          "description": "이 문장에 쓰인 오늘의 단어 id",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^word-\\d{2}$"
          }
        },
        "swissNote": {
          "type": "string"
        }
      }
    },
    "grammarExample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "german",
        "meaning"
      ],
      "properties": {
        "german": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "ß"
          }
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "grammar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "pattern",
        "meaning",
        "explanation",
        "examples"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "title": {
          "description": "카드 제목 (예: Wo ist …?)",
          "type": "string"
        },
        "pattern": {
          "description": "문형 (예: Wo ist + 명사(1격)?)",
          "type": "string"
        },
        "meaning": {
          "description": "한 줄 뜻 (예: “~은 어디에 있나요?”)",
          "type": "string"
        },
        "explanation": {
          "description": "[자세히 보기] 본문",
          "type": "string"
        },
        "examples": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/grammarExample"
          }
        },
        "tip": {
          "type": "string"
        }
      }
    },
    "audioPair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normal"
      ],
      "properties": {
        "normal": {
          "type": "string",
          "pattern": "^/audio/\\d{4}-\\d{2}-\\d{2}/[a-z0-9-]+\\.(opus|mp3)$"
        },
        "slow": {
          "type": "string",
          "pattern": "^/audio/\\d{4}-\\d{2}-\\d{2}/[a-z0-9-]+\\.(opus|mp3)$"
        }
      }
    }
  }
}
