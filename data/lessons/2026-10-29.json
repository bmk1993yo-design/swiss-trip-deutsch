  "grammar": {
    "id": "kommen-aus",
    "title": "Ich komme aus … (aus + 3격)",
    "pattern": "Ich komme aus + 나라·도시(3격). / Woher kommen Sie?",
    "meaning": "저는 ~에서 왔어요. / 어디에서 오셨어요?",
    "explanation": "출신을 말할 때는 Ich komme aus …라고 합니다. aus 뒤의 명사는 3격으로 쓰지만, Korea나 Seoul처럼 보통 관사를 붙이지 않는 지명은 그대로 사용합니다. 관사를 쓰는 나라 이름 die Schweiz는 aus 뒤에서 aus der Schweiz로 바뀝니다. 상대방의 출신을 정중하게 물을 때는 Woher kommen Sie?라고 합니다.",
    "examples": [
      {
        "german": "Ich komme aus Korea.",
        "meaning": "저는 한국에서 왔어요."
      },
      {
        "german": "Ich komme aus Seoul.",
        "meaning": "저는 서울에서 왔어요."
      },
      {
        "german": "Ich komme aus der Schweiz.",
        "meaning": "저는 스위스에서 왔어요."
      },
      {
        "german": "Woher kommen Sie?",
        "meaning": "어디에서 오셨어요?"
      }
    ],
    "tip": "출신을 묻는 woher는 현재 위치를 묻는 wo와 달라요. 직업에 관한 질문은 대화가 자연스럽게 이어질 때 사용해 보세요."
  }
