  "grammar": {
    "id": "ich-brauche",
    "title": "Ich brauche + 4격",
    "pattern": "Ich brauche + 명사(4격)",
    "meaning": "~이/가 필요해요",
    "explanation": "brauchen은 '~이 필요하다'라는 뜻이고 ich와 함께 쓰면 brauche가 됩니다. 필요한 대상은 4격으로 써요. 부정관사는 남성 ein이 einen으로 바뀌고, 여성 eine와 중성 ein은 그대로입니다. 예를 들어 einen Adapter(어댑터 하나), eine Münze(동전 하나), ein Ladegerät(충전기 하나)라고 합니다.",
    "examples": [
      {
        "german": "Ich brauche eine Münze.",
        "meaning": "동전 하나가 필요해요."
      },
      {
        "german": "Ich brauche ein Ladegerät.",
        "meaning": "충전기가 필요해요."
      },
      {
        "german": "Ich brauche einen Adapter.",
        "meaning": "어댑터가 필요해요."
      }
    ],
    "tip": "화장실을 급히 찾을 때도 Ich brauche eine Toilette.라고 말할 수 있어요. 위치를 물으려면 Wo ist das WC?라고 하세요."
  }
