  "grammar": {
    "id": "zu-adjektiv",
    "title": "zu + 형용사",
    "pattern": "주어 + sein + zu + 형용사",
    "meaning": "너무 ~해요",
    "explanation": "형용사 앞에 zu를 붙이면 적당한 정도를 넘어 '너무 ~하다'라는 뜻이 됩니다. 크기가 맞지 않을 때 zu gross(너무 큰), zu klein(너무 작은)이라고 말할 수 있어요. ist 뒤에서 상태를 설명하는 형용사는 어미를 바꾸지 않습니다. 이때 zu는 '~쪽으로'라는 방향이 아니라 정도를 나타냅니다.",
    "examples": [
      {
        "german": "Der Jupe ist zu gross.",
        "meaning": "이 치마는 너무 커요."
      },
      {
        "german": "Das ist zu klein.",
        "meaning": "이것은 너무 작아요."
      },
      {
        "german": "Das Souvenir ist zu teuer.",
        "meaning": "이 기념품은 너무 비싸요."
      }
    ],
    "tip": "사이즈가 맞지 않으면 Das ist zu gross/klein.이라고 말한 뒤 다른 사이즈를 요청해 보세요."
  }
